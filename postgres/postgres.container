[Unit]
Description=PostgreSQL Database
After=network-online.target
Wants=network-online.target

[Container]
# Base options
ContainerName=postgres
Image=docker.io/library/postgres:18-alpine
Pod=postgres.pod

# Storage options
Volume=postgres-data.volume:/var/lib/postgresql

# Environment options
EnvironmentFile=%h/.config/containers/systemd/postgres/.env

# Healthcheck options
HealthCmd=pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=20s
HealthTimeout=5s

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target

