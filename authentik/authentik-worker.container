[Unit]
Description=Authentik Worker
After=network-online.target authentik-postgresql.service authentik-server.service
Requires=authentik-postgresql.service

[Container]
Image=ghcr.io/goauthentik/server:2025.12.4
ContainerName=authentik-worker
Exec=worker
EnvironmentFile=.env
Volume=%t/podman/podman.sock:/var/run/docker.sock
Volume=%h/authentik/data:/data
Volume=%h/authentik/certs:/certs
Volume=%h/authentik/custom-templates:/templates
Pod=authentik.pod

[Service]
ExecStartPre=mkdir -p %h/authentik/data \
    && mkdir -p %h/authentik/certs \
    && mkdir -p %h/authentik/custom-templates
    
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
